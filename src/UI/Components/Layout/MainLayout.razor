@inherits LayoutComponentBase

<div class="flex min-h-screen flex-col">
	<NavMenu />

	<main class="flex-1 px-4 py-8">
		<article>
			@Body
		</article>
	</main>
</div>

<div
	id="blazor-error-ui"
	class="hidden fixed inset-x-0 bottom-0 z-50 bg-yellow-100 px-5 py-3 text-sm text-gray-900"
	data-nosnippet>
	An unhandled error has occurred.
	<a href="." class="reload underline">Reload</a>
	<span class="dismiss cursor-pointer">🗙</span>
</div>
