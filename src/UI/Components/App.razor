@using Domain.Constants
@using UI.Components.Features.Palettes
<!DOCTYPE html>
<html lang="en" class="scheme-light dark:scheme-dark" data-palette="@DataPalette">

<head>
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
	<base href="/"/>
	<ResourcePreloader/>
	<link rel="stylesheet" href="@Assets["css/app.css"]"/>
	<link rel="stylesheet" href="@Assets["UI.styles.css"]"/>
	<ImportMap/>
	<link rel="icon" type="image/png" href="favicon.png"/>
	<HeadOutlet/>
</head>

<body class="bg-slate-50 dark:bg-slate-950">
	<Routes/>
	<ReconnectModal/>
	<script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {

	[CascadingParameter]
	private HttpContext? HttpContext { get; set; }

	private string? DataPalette =>
		Palette.FromCookie(HttpContext?.Request.Cookies[ApplicationConstants.PaletteCookie]).ToDataPalette();

}
