@using Domain.Constants
@using UI.Components.Features.Themes
<!DOCTYPE html>
<html lang="en" class="scheme-light dark:scheme-dark" data-theme="@DataTheme">

<head>
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
	<base href="/"/>
	<ResourcePreloader/>
	<link rel="stylesheet" href="@Assets["css/app.css"]"/>
	<link rel="stylesheet" href="@Assets["UI.styles.css"]"/>
	<ImportMap/>
	<link rel="icon" type="image/png" href="favicon.png"/>
	<HeadOutlet/>
</head>

<body class="bg-slate-50 dark:bg-slate-950">
	<Routes/>
	<ReconnectModal/>
	<script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
	[CascadingParameter] private HttpContext? HttpContext { get; set; }

	// Null for System, so Blazor omits the attribute instead of rendering data-theme="". Palette's data-palette joins
	// here the same way once it has a cookie to read.
	private string? DataTheme { get; set; }

	protected override void OnInitialized()
	{
		string? cookieValue = HttpContext?.Request.Cookies[ApplicationConstants.ThemeCookie];
		DataTheme = Theme.FromCookie(cookieValue).ToDataTheme();
	}
}
