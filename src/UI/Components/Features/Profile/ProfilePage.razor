@page "/profile"
@attribute [Authorize]

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization

<PageTitle>Profile</PageTitle>

<h1 class="text-balance text-4xl font-bold tracking-tight text-gray-900">Profile</h1>

<table class="mt-4 min-w-full divide-y divide-gray-200">
	<thead>
		<tr>
			<th class="py-2 text-left text-sm font-semibold text-gray-900">Claim type</th>
			<th class="py-2 text-left text-sm font-semibold text-gray-900">Value</th>
		</tr>
	</thead>
	<tbody class="divide-y divide-gray-200">
		@foreach (Claim claim in _claims)
		{
			<tr>
				<td class="py-2 text-sm text-gray-600">@claim.Type</td>
				<td class="py-2 text-sm text-gray-600">@claim.Value</td>
			</tr>
		}
	</tbody>
</table>

@code {
	[CascadingParameter]
	private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

	private IReadOnlyList<Claim> _claims = [];

	protected override async Task OnInitializedAsync()
	{
		if (AuthenticationStateTask is not null)
		{
			AuthenticationState authenticationState = await AuthenticationStateTask;
			_claims = [.. authenticationState.User.Claims];
		}
	}
}
