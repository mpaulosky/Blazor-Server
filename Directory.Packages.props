<Project>
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
	</PropertyGroup>
	<ItemGroup Label="Application">
		<PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.5" />
		<PackageVersion Include="Auth0.AspNetCore.Authentication" Version="1.12.0" />
		<PackageVersion Include="FluentValidation" Version="12.2.0" />
		<PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
		<PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
	</ItemGroup>
	<ItemGroup Label="Testing">
		<PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.5" />
		<PackageVersion Include="bunit" Version="2.15.2" />
		<PackageVersion Include="FluentAssertions" Version="8.11.0" />
		<PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.15" />
		<PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
		<PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
		<PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
		<PackageVersion Include="NSubstitute" Version="6.2.0" />
		<PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.3" />
	</ItemGroup>
</Project>
