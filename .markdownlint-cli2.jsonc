// The single markdownlint config for CI and the pre-commit and pre-push hooks.
{
  "config": {
    // Code samples follow .editorconfig, which indents with tabs.
    "MD010": { "code_blocks": false },
    // Tables can't wrap, and the release workflow generates the README Releases table.
    "MD013": { "line_length": 200, "tables": false },
    "MD033": false,
    "MD036": false,
    "MD041": false,
    "MD060": false
  },
  // Also applied to files named on the command line, as the hooks do.
  "ignores": [
    "**/node_modules/**",
    "**/bin/**",
    "**/obj/**",
    ".copilot/**",
    ".claude/skills/**",
    ".github/agents/**",
    ".github/skills/**",
    ".github/copilot-instructions.md",
    // Generated by the release workflow, which copies each PR body verbatim.
    "docs/blogs/**"
  ]
}
