#!/usr/bin/env bash
# Pre-push gate: branch naming, then scripts/gate.sh (lint, build and tests)
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; RESET='\033[0m'

echo -e "${CYAN}━━━ Pre-Push Gate ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"

# Read push refs from stdin (provided by git when run as a hook).
PUSH_REFS="$(cat || true)"

is_protected_branch() {
  [[ "$1" == "main" || "$1" == "preview" || "$1" == "dev" ]]
}

check_branch_name() {
  local branch="$1"

  if is_protected_branch "$branch"; then
    echo -e "${RED}❌ Direct pushes to '${branch}' are not allowed.${RESET}"
    exit 1
  fi

  if ! [[ "$branch" =~ ^(feature|hotfix)/[0-9]+-[a-z0-9]+(-[a-z0-9]+)*$ ]] && ! [[ "$branch" =~ ^chore/[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
    echo -e "${RED}❌ Branch name '${branch}' does not match naming convention.${RESET}"
    echo -e "   Expected: ${YELLOW}feature/{issue-number}-{kebab-slug}${RESET}, ${YELLOW}hotfix/{issue-number}-{kebab-slug}${RESET}, or ${YELLOW}chore/{kebab-slug}${RESET}"
    exit 1
  fi
}

if [[ -n "$PUSH_REFS" ]]; then
  # Gate the refs being pushed, not the checked-out branch: pushing another
  # branch or deleting one from a main checkout is not a push to main.
  # Classify by remote ref: `git push origin v1.0.0:main` has a tag as its
  # local ref but still updates main.
  UPDATES_BRANCH=false
  while read -r _local_ref local_sha remote_ref _remote_sha; do
    [[ "$remote_ref" == refs/heads/* ]] || continue
    branch="${remote_ref#refs/heads/}"

    if [[ "$local_sha" =~ ^0+$ ]]; then
      if is_protected_branch "$branch"; then
        echo -e "${RED}❌ Deleting '${branch}' is not allowed.${RESET}"
        exit 1
      fi
      continue
    fi

    check_branch_name "$branch"
    UPDATES_BRANCH=true
  done <<< "$PUSH_REFS"

  if [[ "$UPDATES_BRANCH" == false ]]; then
    echo -e "${GREEN}✅ No branch updates — skipping the gate.${RESET}"
    exit 0
  fi
else
  # Run by hand: there are no refs on stdin, so gate the checked-out branch.
  check_branch_name "$(git symbolic-ref --short HEAD 2>/dev/null || echo "")"
fi

# The gate runs against the working tree. Sandcastle pushes from the issue
# worktree, which has the pushed branch checked out.
"$ROOT/scripts/gate.sh"

echo -e "\n${GREEN}━━━ All gates passed — pushing ✅ ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}\n"
